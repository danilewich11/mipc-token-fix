# Copy to refresh_mipc.env and fill in. Do NOT commit refresh_mipc.env.

CAMERA_IP="192.168.1.50"
CAMERA_USER="admin"
CAMERA_PASSWORD="change-me"

# go2rtc API (default shown)
#GO2RTC_URL="http://localhost:1984"
#STREAM_NAME="mipc_camera"

# Seconds between URL refreshes
#REFRESH_INTERVAL=270

# Optional: mirror the current URL into a Home Assistant input_text entity.
# Use a dedicated long-lived access token.
#HA_URL="http://localhost:8123"
#HA_TOKEN=""
#HA_ENTITY="input_text.mipc_stream_url"
